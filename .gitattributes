# 줄바꿈 정규화
#
# 윈도우(CRLF)와 그 외(LF)에서 같은 파일을 편집하면, 내용이 하나도 안 바뀌어도
# git이 "파일 전체가 수정됨"으로 인식한다. 실제로 116개 파일이 그렇게 잡혔다.
# 저장소에는 항상 LF로 저장하고, 체크아웃할 때만 각 OS에 맞게 바꾼다.
* text=auto

# 소스·문서는 저장소에서 LF로 통일
*.py    text eol=lf
*.dart  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# 윈도우 배치 파일은 CRLF여야 동작한다
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 바이너리 - 절대 변환하지 말 것
*.pt    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.so    binary
*.jar   binary
*.ttf   binary
*.otf   binary
